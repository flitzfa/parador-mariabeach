# María Beach · Variables de entorno (EJEMPLO, valores ficticios)
# En producción se cargan en Vercel → Project → Settings → Environment Variables.
# Para probar en tu compu con `vercel dev`, copiá este archivo como `.env.local`
# (está ignorado por git) y poné los valores reales.

# URL del proyecto de Supabase (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave PÚBLICA del proyecto (Settings → API Keys → "Publishable key", empieza con sb_publishable_)
# En proyectos viejos puede llamarse "anon public". Cualquiera de las dos sirve.
# NUNCA pongas acá la "secret key" ni la "service_role": el panel no la necesita
# y el código la rechaza a propósito.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EJEMPLO_NO_REAL_0000000000
